# Copy this file to .env and fill in one key. .env is git-ignored. Leave LLM_PROVIDER=replay to use no key.
LLM_PROVIDER=replay
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=
OLLAMA_URL=

# Langfuse, only for the closing part. Cloud is the default host. Never type these in a command.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
